{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mc-mods-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // 公開URL: https://mc-mods.enderman-desu.org
  "routes": [{ "pattern": "mc-mods.enderman-desu.org", "custom_domain": true }],

  // サーバーから届いたMod一覧と、生成したpackwizファイルの保存場所
  // id は初回デプロイ前に `npx wrangler kv namespace create PACK` で作って書き換える
  "kv_namespaces": [{ "binding": "PACK", "id": "d2fb014f34404dd4a864c56a734cd0fa" }],

  // 秘密でない設定値。NeoForge を更新したら NEOFORGE_VERSION も書き換えてデプロイする
  // PORTS: パックを分けて持つサーバーのポート（カンマ区切り）。ここに無いポートの送信は断る
  "vars": {
    "PORTS": "25564,25565,25566,25567",
    "PACK_NAME": "ModdedMC-Onsengai",
    "MC_VERSION": "1.21.1",
    "NEOFORGE_VERSION": "21.1.259"
  }

  // 秘密の値（コードや設定ファイルには書かない）:
  //   CURSEFORGE_API_KEY, UPLOAD_TOKEN
  //   ローカル: .env に記入 / 本番: `npx wrangler secret put <名前>`
}
